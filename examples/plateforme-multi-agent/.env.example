# Copier en .env et remplir. Sans clé = mode stub (aucun appel réel).

# --- Anthropic (dashboard : chat interactif via AI SDK)
ANTHROPIC_API_KEY=

# --- Réseaux sociaux
LINKEDIN_ACCESS_TOKEN=
YOUTUBE_API_KEY=
INSTAGRAM_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=

# --- Outils créatifs
CANVA_ACCESS_TOKEN=
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
IDEOGRAM_API_KEY=

# --- Agents support
GMAIL_OAUTH_TOKEN=
GOOGLE_DRIVE_OAUTH_TOKEN=
FIREFLIES_API_KEY=

# --- Dashboard
BACKEND_URL=http://localhost:8000
